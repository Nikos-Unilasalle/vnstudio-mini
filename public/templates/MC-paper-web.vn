  {
   "id": "node-1782710392200-fj2ugkk3u",
   "type": "logic_python",
   "position": {
    "x": 2680,
    "y": 200
   },
   "style": {},
   "data": {
    "label": "Python Node",
    "params": {
     "code": "// Index Correlation (threshold-independent validation)\n//   a = MC P(water) (image 0-255, acc_mean)\n//   b = idx.stack (geotiff, N bands = indices)\n//   c = open-water reference (mask or occurrence geotiff, optional)\n//   d = river-extent reference (mask, optional)\n//   e = analysis domain (mask, optional — GT dilated)\n// Outputs: out_fig / out_dist / out_auroc (images), out_stats (dict),\n//          out_ow / out_ext / out_gt / out_domain (masks on the P grid).\nconst W = a.cols, H = a.rows, px = W * H;\nconst Ad = a.data, Ac = a.channels();\nconst Pw = new Float64Array(px);\nfor (let i = 0; i < px; i++) Pw[i] = Ad[i * Ac] / 255;\n\nlet pmin = Infinity, pmax = -Infinity, psum = 0;\nfor (let i = 0; i < px; i++) { if (Pw[i] < pmin) pmin = Pw[i]; if (Pw[i] > pmax) pmax = Pw[i]; psum += Pw[i]; }\nconst pmean = psum / px;\nlet pvar = 0;\nfor (let i = 0; i < px; i++) pvar += (Pw[i] - pmean) ** 2;\nconst pstd = Math.sqrt(pvar / px);\n\nconst bands = b.bands, names = b.band_names && b.band_names.length ? b.band_names : bands.map((_, i) => 'idx' + i);\nconst N = bands.length;\nif (b.width !== W || b.height !== H) throw new Error('grid P ' + W + 'x' + H + ' != indices ' + b.width + 'x' + b.height);\n\n// A plain mask is aligned by dimension ratio; an occurrence raster carrying a\n// transform is resampled through world coordinates instead.\nconst asBool = (m) => {\n  if (!m) return null;\n  if (m.bands) {                              // geotiff: occurrence percentage\n    const src = m.bands[0], out = new Float64Array(px);\n    const bt = b.transform, jt = m.transform;\n    if (bt && jt) {\n      for (let y = 0; y < H; y++) {\n        const wy = jt ? bt[5] + (y + 0.5) * bt[4] : 0;\n        const jr = Math.min(Math.max(Math.round((wy - jt[5]) / jt[4] - 0.5), 0), m.height - 1);\n        for (let x = 0; x < W; x++) {\n          const wx = bt[2] + (x + 0.5) * bt[0];\n          const jc = Math.min(Math.max(Math.round((wx - jt[2]) / jt[0] - 0.5), 0), m.width - 1);\n          out[y * W + x] = src[jr * m.width + jc];\n        }\n      }\n    } else {\n      for (let y = 0; y < H; y++) {\n        const sy = Math.min(Math.floor((y * m.height) / H), m.height - 1);\n        for (let x = 0; x < W; x++) {\n          const sx = Math.min(Math.floor((x * m.width) / W), m.width - 1);\n          out[y * W + x] = src[sy * m.width + sx];\n        }\n      }\n    }\n    return { occ: out };\n  }\n  const d = m.data, ch = m.channels(), o = new Uint8Array(px);\n  for (let y = 0; y < H; y++) {\n    const sy = Math.min(Math.floor((y * m.rows) / H), m.rows - 1);\n    for (let x = 0; x < W; x++) {\n      const sx = Math.min(Math.floor((x * m.cols) / W), m.cols - 1);\n      o[y * W + x] = d[(sy * m.cols + sx) * ch] > 127 ? 1 : 0;\n    }\n  }\n  return o;\n};\n\nconst OCC_OW = 75, OCC_EXT = 10, OCC_GT = 50;\nconst cIn = typeof c !== 'undefined' ? c : null;\nconst dIn = typeof d !== 'undefined' ? d : null;\nconst eIn = typeof e !== 'undefined' ? e : null;\n\nlet ow = null, ext = null, gt = null;\nconst cRes = asBool(cIn);\nif (cRes && cRes.occ) {\n  const occ = cRes.occ;\n  ext = new Uint8Array(px); ow = new Uint8Array(px); gt = new Uint8Array(px);\n  for (let i = 0; i < px; i++) {\n    ext[i] = occ[i] >= OCC_EXT ? 1 : 0;\n    ow[i] = occ[i] >= OCC_OW ? 1 : 0;\n    gt[i] = occ[i] >= OCC_GT ? 1 : 0;\n  }\n} else {\n  const mc = cRes, md = asBool(dIn);\n  ow = mc || md;\n  ext = md || mc;      // a single reference mask serves as both\n  gt = ext;\n}\nconst ones = () => { const o = new Uint8Array(px); o.fill(1); return o; };\nif (!ext) ext = ones();\nif (!ow) ow = ext;\nif (!gt) gt = ext;\nconst any = (m) => { for (let i = 0; i < px; i++) if (m[i]) return true; return false; };\nif (!any(ext)) { ext = ones(); if (!any(ow)) ow = ext; if (!any(gt)) gt = ext; }\n\n// \"All river\" = every pixel of the domain (water + banks), which is what tests\n// P~0 on land against P~1 on water. Without e the whole image is the domain.\nconst domain = asBool(eIn) || ones();\nconst bridge = new Uint8Array(px);\nfor (let i = 0; i < px; i++) bridge[i] = domain[i] && !ow[i] ? 1 : 0;   // negative class = non-water land\n\nconst toMask = (m) => {\n  const mat = track(new cv.Mat(H, W, cv.CV_8U));\n  const out = mat.data;\n  for (let i = 0; i < px; i++) out[i] = m[i] ? 255 : 0;\n  return mat;\n};\nout_ow = toMask(ow); out_ext = toMask(ext); out_gt = toMask(gt); out_domain = toMask(domain);\n\n// --- statistics ---\nconst rankdata = (v) => {                      // average ranks over ties, as scipy does\n  const order = Array.from(v.keys()).sort((i, j) => v[i] - v[j]);\n  const ranks = new Float64Array(v.length);\n  let i = 0;\n  while (i < order.length) {\n    let j = i;\n    while (j + 1 < order.length && v[order[j + 1]] === v[order[i]]) j++;\n    const mean = (i + j + 2) / 2;\n    for (let k = i; k <= j; k++) ranks[order[k]] = mean;\n    i = j + 1;\n  }\n  return ranks;\n};\nconst pearson = (x, y) => {\n  const n = x.length;\n  if (n < 2) return NaN;\n  let mx = 0, my = 0;\n  for (let i = 0; i < n; i++) { mx += x[i]; my += y[i]; }\n  mx /= n; my /= n;\n  let num = 0, dx = 0, dy = 0;\n  for (let i = 0; i < n; i++) {\n    const p = x[i] - mx, q = y[i] - my;\n    num += p * q; dx += p * p; dy += q * q;\n  }\n  return dx > 0 && dy > 0 ? num / Math.sqrt(dx * dy) : NaN;\n};\nconst spearman = (x, y) => pearson(rankdata(x), rankdata(y));\n\nconst rho = (values, mask) => {\n  const xs = [], ys = [];\n  for (let i = 0; i < px; i++) {\n    if (!mask[i] || !Number.isFinite(values[i]) || !Number.isFinite(Pw[i])) continue;\n    xs.push(Pw[i]); ys.push(values[i]);\n  }\n  if (xs.length < 10) return NaN;\n  return spearman(Float64Array.from(xs), Float64Array.from(ys));\n};\n\nconst classes = [['All river', domain, [128, 128, 128]], ['Open water', ow, [180, 119, 31]], ['Land', bridge, [14, 127, 255]]];\nconst R = {};\nfor (const [name, mask] of classes) R[name] = bands.map((values) => rho(values, mask));\n\n// --- figure 1: Spearman by class and index ---\nconst figR = plot.figure({\n  width: 900, height: 420, title: 'Spearman: MC P(water) vs spectral index by pixel class',\n  xlabel: 'index', ylabel: 'Spearman r', ylim: [0, 1.05], xlim: [-0.5, N - 0.5],\n});\nclasses.forEach(([name, , colour], k) => {\n  const xs = bands.map((_, i) => i + (k - 1) * 0.26);\n  figR.bars(xs, R[name].map((v) => (Number.isFinite(v) ? v : 0)), { color: colour, barWidth: 0.24, label: name });\n});\nout_fig = track(figR.render());\n\n// --- distributions: open water vs land, per feature ---\nconst values = (arr, mask) => { const o = []; for (let i = 0; i < px; i++) if (mask[i] && Number.isFinite(arr[i])) o.push(arr[i]); return o; };\nconst mean = (v) => v.reduce((s, x) => s + x, 0) / v.length;\nconst variance = (v, m) => v.reduce((s, x) => s + (x - m) ** 2, 0) / Math.max(v.length - 1, 1);\n\n// Mann-Whitney U through the rank sum, with the normal approximation and a tie\n// correction for the p-value; the same statistic gives AUROC below.\nconst mannWhitney = (va, vb) => {\n  const n1 = va.length, n2 = vb.length;\n  if (n1 < 1 || n2 < 1) return { u: NaN, p: NaN, rb: NaN };\n  const all = Float64Array.from([...va, ...vb]);\n  const ranks = rankdata(all);\n  let r1 = 0;\n  for (let i = 0; i < n1; i++) r1 += ranks[i];\n  const u = r1 - (n1 * (n1 + 1)) / 2;\n  const counts = new Map();\n  for (const v of all) counts.set(v, (counts.get(v) || 0) + 1);\n  let tie = 0;\n  for (const t of counts.values()) if (t > 1) tie += t * t * t - t;\n  const n = n1 + n2;\n  const sd = Math.sqrt((n1 * n2 / 12) * ((n + 1) - tie / (n * (n - 1))));\n  const z = sd > 0 ? (u - (n1 * n2) / 2) / sd : 0;\n  // Two-sided normal tail, Abramowitz & Stegun 7.1.26 for erf.\n  const erf = (x) => {\n    const s = x < 0 ? -1 : 1; x = Math.abs(x);\n    const t = 1 / (1 + 0.3275911 * x);\n    const y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);\n    return s * y;\n  };\n  const p = 2 * (1 - 0.5 * (1 + erf(Math.abs(z) / Math.SQRT2)));\n  return { u, p: Math.min(Math.max(p, 0), 1), rb: 1 - (2 * u) / (n1 * n2) };\n};\n\nconst MWU_MAX = 20000;\nconst cap = (v) => (v.length <= MWU_MAX ? v : v.filter((_, i) => i % Math.ceil(v.length / MWU_MAX) === 0));\nconst features = [['MC prob', Pw], ...bands.map((arr, i) => [names[i], arr])];\nconst dmu = {}, cohen = {}, mw = {};\nconst figD = plot.figure({ width: 900, height: 380, title: 'Open water vs land — mean gap by feature', xlabel: 'feature', ylabel: 'delta mu' });\nconst gaps = [], labels = [];\nfor (const [name, arr] of features) {\n  const vo = values(arr, ow), vb = values(arr, bridge);\n  if (vo.length >= 2 && vb.length >= 2) {\n    const mo = mean(vo), mb = mean(vb);\n    const gap = mo - mb;\n    dmu[name] = Math.round(gap * 1e4) / 1e4;\n    const pooled = Math.sqrt(((vo.length - 1) * variance(vo, mo) + (vb.length - 1) * variance(vb, mb)) / Math.max(vo.length + vb.length - 2, 1));\n    cohen[name] = Math.round((gap / (pooled + 1e-12)) * 1e3) / 1e3;\n    const test = mannWhitney(cap(vo), cap(vb));\n    mw[name] = {\n      p: Number.isFinite(test.p) ? Math.round(test.p * 1e6) / 1e6 : null,\n      rank_biserial: Number.isFinite(test.rb) ? Math.round(test.rb * 1e3) / 1e3 : null,\n      n_open_water: Math.min(vo.length, MWU_MAX), n_bridge: Math.min(vb.length, MWU_MAX),\n    };\n    gaps.push(gap); labels.push(name);\n  } else { dmu[name] = null; cohen[name] = null; mw[name] = null; }\n}\nfigD.bars(gaps.map((_, i) => i), gaps, { color: [180, 119, 31], barWidth: 0.6, label: 'mean(open water) - mean(land)' });\nout_dist = track(figD.render());\n\n// --- independent discriminability: index vs GT water, P-free ---\n// The target is the ground truth (water) against the corridor's non-water, so\n// the ranking of the indices never touches P and stays non-circular.\nconst auroc = (arr, pos, neg) => {\n  const va = values(arr, pos), vb = values(arr, neg);\n  if (!va.length || !vb.length) return NaN;\n  const ranks = rankdata(Float64Array.from([...va, ...vb]));\n  let sum = 0;\n  for (let i = 0; i < va.length; i++) sum += ranks[i];\n  return (sum - (va.length * (va.length + 1)) / 2) / (va.length * vb.length);\n};\nconst negDomain = new Uint8Array(px);\nfor (let i = 0; i < px; i++) negDomain[i] = domain[i] && !ow[i] ? 1 : 0;\nconst auc = {};\nbands.forEach((arr, i) => {\n  const value = auroc(arr, ow, negDomain);\n  auc[names[i]] = Number.isFinite(value) ? Math.round(Math.max(value, 1 - value) * 1e4) / 1e4 : null;\n});\nconst order = Object.keys(auc).sort((x, y) => (auc[y] ?? 0.5) - (auc[x] ?? 0.5));\nconst figA = plot.figure({\n  width: 680, height: 400, title: 'Index discriminability vs ground truth (P-free)',\n  xlabel: 'index', ylabel: 'AUROC (water vs non-water)', ylim: [0.5, 1.02],\n});\nfigA.bars(order.map((_, i) => i), order.map((k) => auc[k] ?? 0.5), { color: [44, 160, 44], barWidth: 0.6, label: 'AUROC' });\nfigA.hline(0.5, { color: [40, 40, 40] });\nout_auroc = track(figA.render());\n\nout_stats = {};\nnames.forEach((name, i) => {\n  out_stats[name] = {};\n  for (const [cn] of classes) out_stats[name][cn] = Number.isFinite(R[cn][i]) ? Math.round(R[cn][i] * 1e4) / 1e4 : null;\n});\nout_stats.P_stats = { min: Math.round(pmin * 1e3) / 1e3, max: Math.round(pmax * 1e3) / 1e3, std: Math.round(pstd * 1e4) / 1e4 };\nout_stats.class_pixels = { ext: ext.reduce((s, v) => s + v, 0), ow: ow.reduce((s, v) => s + v, 0), domain: domain.reduce((s, v) => s + v, 0) };\nout_stats.delta_mu = dmu;\nout_stats.cohen_d = cohen;\nout_stats.mann_whitney = mw;\nout_stats.auroc_vs_gt = auc;\n",
     "color_index": 0,
     "node_note": "Validation. a=P, b=idx.stack, c=ow(WorldCover water), d=ext(water∪bridge). All river = ext DILATEE (ROI_DILATE_PX dans le code). Open water=c, Land=domain&~c (no OSM). Plans d'eau conserves."
    },
    "ports": [
     {
      "id": "image__a",
      "color": "image",
      "label": "a = P"
