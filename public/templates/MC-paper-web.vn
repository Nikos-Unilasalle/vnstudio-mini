  {
   "id": "mc_cal",
   "type": "logic_python",
   "position": {
    "x": 3180,
    "y": 2240
   },
   "style": {},
   "data": {
    "label": "Python Node",
    "userLabel": "MC Calibration (Brier/ECE/⟨U⟩)",
    "params": {
     "code": "// MC Calibration — Brier score, Expected/Maximum Calibration Error, mean uncertainty.\n//   a = P (acc_mean image, 0-255) = predicted water probability\n//   b = truth mask (aligned GT, water=1)\n//   c = domain mask (opt, restricts evaluation to the river corridor)\n//   d = MC uncertainty map sigma_P (opt, from the std accumulator) — for <U> = <sigma_P>\n//   e = number of reliability bins (opt, default 12)\n// Checks whether P behaves as a calibrated probability (pixels at P~q are water\n// ~q of the time), not merely a rank score.\nconst px = a.rows * a.cols;\nconst Pd = a.data, Pc = a.channels();\nconst Td = b.data, Tc = b.channels();\nconst Dd = typeof c !== 'undefined' && c ? c.data : null, Dc = Dd ? c.channels() : 1;\nlet nb = typeof e !== 'undefined' && Number.isFinite(Number(e)) ? Math.round(Number(e)) : 12;\nnb = Math.min(Math.max(nb, 3), 50);\n\nconst Pv = [], yv = [];\nconst keep = new Uint8Array(px);\nfor (let i = 0; i < px; i++) {\n  if (Dd && !(Dd[i * Dc] > 127)) continue;\n  keep[i] = 1;\n  Pv.push(Pd[i * Pc] / 255);\n  yv.push(Td[i * Tc] > 127 ? 1 : 0);\n}\nconst n = Pv.length;\nif (n < 30) throw new Error('too few pixels in domain (' + n + ')');\n\n// Brier score = mean squared error between probability and binary outcome\nlet brier = 0;\nfor (let i = 0; i < n; i++) brier += (Pv[i] - yv[i]) ** 2;\nbrier /= n;\n\n// Reliability: bin by predicted probability, compare mean confidence vs empirical accuracy\nconst edges = Array.from({ length: nb + 1 }, (_, k) => k / nb);\nconst confSum = new Float64Array(nb), accSum = new Float64Array(nb), cnt = new Float64Array(nb);\nfor (let i = 0; i < n; i++) {\n  // numpy's digitize minus one, clamped: the value 1.0 belongs to the last bin.\n  let k = Math.floor(Pv[i] * nb);\n  if (k < 0) k = 0; else if (k >= nb) k = nb - 1;\n  cnt[k]++; confSum[k] += Pv[i]; accSum[k] += yv[i];\n}\nconst conf = [], acc = [], centres = [], weights = [];\nlet ece = 0, mce = NaN;\nfor (let k = 0; k < nb; k++) {\n  const w = cnt[k] / n;\n  weights.push(w);\n  centres.push((edges[k] + edges[k + 1]) / 2);\n  if (cnt[k] > 0) {\n    const cf = confSum[k] / cnt[k], ac = accSum[k] / cnt[k];\n    conf.push(cf); acc.push(ac);\n    const gap = Math.abs(ac - cf);\n    ece += w * gap;\n    mce = Number.isFinite(mce) ? Math.max(mce, gap) : gap;\n  }\n}\n\n// Mean uncertainty <U>: the MC ensemble std map when given, else the Bernoulli\n// predictive variance P(1-P), which peaks at P = 0.5 (maximal indecision).\nlet U, Usrc;\nif (typeof d !== 'undefined' && d && d.rows) {\n  const Sd = d.data, Sc = d.channels();\n  let max = 0;\n  for (let i = 0; i < px; i++) if (Sd[i * Sc] > max) max = Sd[i * Sc];\n  const scale = max > 1.5 ? 1 / 255 : 1;\n  let sum = 0, m = 0;\n  for (let i = 0; i < px; i++) if (keep[i]) { sum += Sd[i * Sc] * scale; m++; }\n  U = m ? sum / m : NaN; Usrc = 'ensemble_std';\n} else {\n  let sum = 0;\n  for (let i = 0; i < n; i++) sum += Pv[i] * (1 - Pv[i]);\n  U = sum / n; Usrc = 'bernoulli_var';\n}\n\nconst r4 = (v) => Number.isFinite(v) ? Math.round(v * 1e4) / 1e4 : null;\nconst fig = plot.figure({\n  width: 620, height: 560, title: 'Reliability diagram — MC P(water)',\n  xlabel: 'Predicted P(water)', ylabel: 'Empirical accuracy (fraction water)',\n  xlim: [0, 1], ylim: [0, 1],\n});\nfig.line([0, 1], [0, 1], { color: [40, 40, 40], dashed: true, width: 1, label: 'perfect calibration' });\nfig.line(conf, acc, { color: [180, 119, 31], marker: true, label: 'observed' });\nfig.bars(centres, weights, { color: [150, 150, 150], barWidth: 0.9, label: 'bin fraction' });\nconst reliability = track(fig.render());\ncv.putText(reliability, 'Brier ' + r4(brier) + '  ECE ' + r4(ece) + '  MCE ' + r4(mce),\n  new cv.Point(76, 52), cv.FONT_HERSHEY_SIMPLEX, 0.4, new cv.Scalar(40, 40, 40, 255), 1, cv.LINE_AA);\ncv.putText(reliability, '<U> ' + r4(U) + ' (' + Usrc + ')',\n  new cv.Point(76, 68), cv.FONT_HERSHEY_SIMPLEX, 0.4, new cv.Scalar(40, 40, 40, 255), 1, cv.LINE_AA);\n\nout_reliability = reliability;\nout_cal = {\n  brier: r4(brier), ece: r4(ece), mce: r4(mce),\n  mean_uncertainty: r4(U), uncertainty_source: Usrc,\n  n_bins: nb, n_pixels: n,\n};\n",
     "color_index": 3,
     "node_note": "Calibration de P: Brier, ECE/MCE, reliability diagram, ⟨U⟩. a=P(acc_mean), b=GT aligne(out_gt), c=domaine, d=σ_P(acc_std,opt), e=n_bins."
    },
    "ports": [
     {
      "id": "image__a",
      "color": "image",
      "label": "a = P"
     },
