  {
   "id": "mc_conv",
   "type": "logic_python",
   "position": {
    "x": 2400,
    "y": 1500
   },
   "style": {},
   "data": {
    "label": "Python Node",
    "userLabel": "MC Convergence",
    "params": {
     "code": "// MC Convergence monitor — scene-mean standard error of P vs number of MC steps.\n//   a = MC std map (acc_std 'main', 0-255)   b = frame_count N (scalar)\n//   c = domain mask (opt)   d = SE tolerance (opt, default 0.01)   e = min N before eval (opt, default 5)\n// SE(N) = mean_pixels(sigma_P) / sqrt(N), sigma_P = per-pixel ensemble std in P units.\n// Optimal N = first N (>= min_n) where SE < tolerance. Curve accumulates in `state` across ticks.\nconst TOL = typeof d !== 'undefined' && Number.isFinite(Number(d)) ? Number(d) : 0.01;\nconst MIN_N = typeof e !== 'undefined' && Number.isFinite(Number(e)) ? Math.round(Number(e)) : 5;\n\nconst chan = a.channels(), px = a.rows * a.cols, sd8 = a.data;\nconst dom = typeof c !== 'undefined' && c ? c.data : null;\nconst domCh = dom ? c.channels() : 1;\n\nlet sum = 0, count = 0;\nfor (let i = 0; i < px; i++) {\n  if (dom && !(dom[i * domCh] > 127)) continue;\n  const v = sd8[i * chan] / 255;\n  if (!Number.isFinite(v)) continue;\n  sum += v; count++;\n}\nconst sd = count ? sum / count : NaN;\nconst N = typeof b !== 'undefined' && Number.isFinite(Number(b)) ? Math.round(Number(b)) : 0;\nconst se = sd / Math.sqrt(Math.max(N, 1));\n\nlet hist = state.conv_hist;\n// A run that restarts (N going backwards) starts a fresh curve.\nif (!hist || N < (state.conv_lastN || 0)) hist = [];\nstate.conv_lastN = N;\nif (N >= 2 && Number.isFinite(se)) {\n  if (!hist.length || hist[hist.length - 1][0] !== N) hist.push([N, se]);   // one point per distinct N\n}\nstate.conv_hist = hist;\n\nconst Ns = hist.map((p) => p[0]), SEs = hist.map((p) => p[1]);\nlet optN = -1;\nfor (const [nn, ss] of hist) { if (nn >= MIN_N && ss < TOL) { optN = nn; break; } }\n\nconst positive = SEs.filter((s) => s > 0);\nconst fig = plot.figure({\n  width: 700, height: 450, title: 'Monte-Carlo convergence',\n  xlabel: 'MC steps (N)', ylabel: 'Scene-mean SE of P',\n  logY: SEs.length >= 2 && positive.length === SEs.length,\n});\nif (Ns.length) fig.line(Ns, SEs, { color: [180, 119, 31], marker: true, label: 'SE of P = sigma/sqrt(N)' });\nfig.hline(TOL, { color: [40, 40, 40], label: 'tolerance = ' + TOL });\nif (optN > 0) fig.vline(optN, { color: [44, 160, 44], width: 2, label: 'optimal N ~ ' + optN });\n\nout_curve = track(fig.render());\nout_optimal_N = optN;\nout_se = se;\n",
     "color_index": 3,
     "node_note": "Courbe SE=σ/√N vs N. N optimal = 1er N (>=5) sous TOL (0.01, editable dans le code). a=acc_std, b=frame_count, c=domaine."
    },
    "ports": [
     {
      "id": "image__a",
      "color": "image",
      "label": "a = σ map (acc_std)"
     },
     {
      "id": "scalar__b",
      "color": "scalar",
      "label": "b = N (frame_count)"
     },
     {
      "id": "mask__c",
      "color": "mask",
      "label": "c = domain (opt)"
     },
     {
      "id": "scalar__d",
      "color": "scalar",
      "label": "d = SE tolerance"
     },
     {
      "id": "scalar__e",
      "color": "scalar",
      "label": "e = min N before eval"
     },
     {
      "id": "scalar__f",
      "color": "scalar",
      "label": "f"
     }
    ],
    "outPorts": [
     {
      "id": "image__out_curve",
