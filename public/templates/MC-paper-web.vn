  {
   "id": "adaptive_gate",
   "type": "logic_python",
   "position": {
    "x": 1480,
    "y": 200
   },
   "style": {},
   "data": {
    "label": "Python Node",
    "userLabel": "Adaptive Gate (p99 consensus)",
    "params": {
     "code": "// Adaptive reflectance gate — faithful to compute_adaptive_constraints + the\n// decision_water gate. base = un-noised stack, pert = noised stack.\n//   CDSE order B04,B03,B02,B08,B11,B12 = red,green,blue,nir,swir1,swir2.\n// The p99 caps come from the consensus pixels of the BASE scene and are frozen\n// for the whole run (floor = 2x the fixed cap, fallback to fixed caps below 500\n// px). The gate itself is applied to the NOISED bands.\nconst VOTE_K = 2, PCT = 99.0, MIN_PIX = 500;\nconst NIR_MAX = 0.12, SWIR1_MAX = 0.06, SWIR2_MAX = 0.05;\nconst FLOOR_MULT = 2.0;\nconst BAND_MIN = -0.002, DEN_MIN = 1e-6;\n\nconst b6 = (g) => {\n  const s = g.bands;\n  return { bl: s[2], gr: s[1], rd: s[0], ni: s[3], s1: s[4], s2: s[5] };\n};\nconst nd = (x, y, i) => {\n  const den = x[i] + y[i];\n  if (!(Number.isFinite(x[i]) && Number.isFinite(y[i]))) return NaN;\n  if (Math.abs(den) <= DEN_MIN || x[i] <= BAND_MIN || y[i] <= BAND_MIN) return NaN;\n  const v = (x[i] - y[i]) / den;\n  return v < -1 ? -1 : v > 1 ? 1 : v;\n};\nconst votes = (B, i) => {\n  const ndwi = nd(B.gr, B.ni, i), mndwi = nd(B.gr, B.s1, i);\n  const awei = B.bl[i] + 2.5 * B.gr[i] - 1.5 * (B.ni[i] + B.s1[i]) - 0.25 * B.s2[i];   // AWEIsh\n  const mbwi = 3.0 * B.gr[i] - (B.rd[i] + B.ni[i] + B.s1[i] + B.s2[i]);                // MBWI factor 3\n  return (Number.isFinite(ndwi) && ndwi > 0 ? 1 : 0)\n       + (Number.isFinite(mndwi) && mndwi > 0 ? 1 : 0)\n       + (Number.isFinite(awei) && awei > 0 ? 1 : 0)\n       + (Number.isFinite(mbwi) && mbwi > 0 ? 1 : 0);\n};\nconst percentile = (arr, q) => {\n  if (!arr.length) return NaN;\n  const s = Float64Array.from(arr).sort();\n  const pos = (q / 100) * (s.length - 1), lo = Math.floor(pos), hi = Math.ceil(pos);\n  return lo === hi ? s[lo] : s[lo] + (s[hi] - s[lo]) * (pos - lo);\n};\n\n// --- caps frozen on the base scene, computed once per run ---\nconst B = b6(base);\nconst px = base.width * base.height;\nlet nirSum = 0;\nfor (let i = 0; i < px; i++) if (Number.isFinite(B.ni[i])) nirSum += B.ni[i];\nconst sig = base.width + 'x' + base.height + ':' + (Math.round(nirSum * 1000) / 1000);\n\nif (state.gate_sig !== sig || !state.caps) {\n  const consNi = [], consS1 = [], consS2 = [];\n  for (let i = 0; i < px; i++) {\n    if (!(Number.isFinite(B.bl[i]) && Number.isFinite(B.gr[i]) && Number.isFinite(B.rd[i])\n       && Number.isFinite(B.ni[i]) && Number.isFinite(B.s1[i]) && Number.isFinite(B.s2[i]))) continue;\n    if (votes(B, i) >= VOTE_K) { consNi.push(B.ni[i]); consS1.push(B.s1[i]); consS2.push(B.s2[i]); }\n  }\n  const n = consNi.length;\n  state.caps = n >= MIN_PIX\n    ? [Math.max(percentile(consNi, PCT), NIR_MAX * FLOOR_MULT),\n       Math.max(percentile(consS1, PCT), SWIR1_MAX * FLOOR_MULT),\n       Math.max(percentile(consS2, PCT), SWIR2_MAX * FLOOR_MULT), true, n]\n    : [NIR_MAX, SWIR1_MAX, SWIR2_MAX, false, n];\n  state.gate_sig = sig;\n}\nconst [nc, c1, c2, adaptive, nCons] = state.caps;\n\n// --- gate applied to the NOISED bands, with the frozen caps ---\nconst Pb = b6(pert);\nconst mask = track(new cv.Mat(pert.height, pert.width, cv.CV_8U));\nconst out = mask.data;\nfor (let i = 0; i < px; i++) {\n  const ok = Number.isFinite(Pb.bl[i]) && Number.isFinite(Pb.gr[i]) && Number.isFinite(Pb.rd[i])\n          && Number.isFinite(Pb.ni[i]) && Number.isFinite(Pb.s1[i]) && Number.isFinite(Pb.s2[i])\n          && Pb.ni[i] < nc && Pb.s1[i] < c1 && Pb.s2[i] < c2;\n  // No brightness floor: it would also delete dark open water (NIR/SWIR ~ 0),\n  // which is the darkest target. The NIR/SWIR caps plus the k-of-4 vote suffice.\n  out[i] = ok ? 255 : 0;\n}\n\nconst r4 = (v) => Math.round(v * 1e4) / 1e4;\nout_mask = mask;\nout_caps = { adaptive, n_consensus: nCons, nir_cap: r4(nc), swir1_cap: r4(c1), swir2_cap: r4(c2) };\n",
     "node_note": "Gate de reflectance scene-adaptatif. base=CDSE L2A SR (non bruite), pert=noise (bruite). _b6 ordre CDSE B04,B03,B02,B08,B11,B12 -> blue,green,red,nir,swir1,swir2. Caps p99 auto-cales sur pixels consensus (repli fixe SR NIR<0.12 SWIR1<0.06 SWIR2<0.05 si <500 px).",
     "color_index": 1
    },
    "ports": [
     {
      "id": "geotiff__base",
      "color": "geotiff",
      "label": "base"
     },
     {
      "id": "geotiff__pert",
      "color": "geotiff",
      "label": "pert"
     }
    ],
    "outPorts": [
     {
      "id": "mask__out_mask",
      "color": "mask",
      "label": "gate"
     },
     {
      "id": "any__out_caps",
      "color": "any",
      "label": "caps"
     }
    ]
   },
   "width": 208,
   "height": 121,
   "selected": false,
   "dragging": false,
   "positionAbsolute": {
    "x": 1480,
    "y": 200
   }
  },
