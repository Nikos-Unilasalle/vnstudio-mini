  {
   "id": "n-intro",
   "type": "canvas_note",
   "position": {
    "x": -80,
    "y": -420
   },
   "data": {
    "label": "Note",
    "params": {
     "text": "MISSION 1.1 — Le tamis qui n'existe pas\n\nCette chaîne fonctionne parfaitement sur galets_atelier.jpg.\nSuis le fil de gauche à droite. Pour voir ce qu'une node produit :\nclique dessus, puis appuie sur Entrée.\n\nEtape 2 : remplace l'image par berge_meuse.jpg et relance. Ne touche a rien d'autre.",
     "color_index": 0
    }
   },
   "width": 900,
   "height": 260,
   "selected": false,
   "dragging": false,
   "positionAbsolute": {
    "x": -80,
    "y": -420
   },
   "style": {
    "width": 900,
    "height": 260
   }
  },
  {
   "id": "n-path",
   "type": "canvas_note",
   "position": {
    "x": -40,
    "y": 380
   },
   "data": {
    "label": "Note",
    "params": {
     "text": "Si l'image ne s'affiche pas : clique sur la node Image File et corrige le chemin\npour qu'elle pointe vers TA copie de galets_atelier.jpg.",
     "color_index": 1
    }
   },
   "width": 420,
   "height": 180,
