  },
  {
   "id": "n-calib",
   "type": "canvas_note",
   "position": {
    "x": 1320,
    "y": 380
   },
   "data": {
    "label": "Note",
    "params": {
     "text": "Calibration : la piece de 2 euros fait 25,75 mm et mesure 232 px sur cette photo.\n25,75 / 232 = 0,1108 mm/px, soit 110,8 um/px — la valeur reglee ici.\n\nCette valeur ne vaut que pour la photo d'atelier. Sur une autre photo, refais le calcul.",
     "color_index": 3
    }
   },
   "width": 440,
   "height": 220,
   "selected": false,
   "dragging": false,
   "positionAbsolute": {
    "x": 1320,
    "y": 380
   },
   "style": {
    "width": 440,
    "height": 220
   }
