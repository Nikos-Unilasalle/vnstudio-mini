      "selected": false
    },
    {
      "id": "nanC",
      "type": "logic_python",
      "position": {
        "x": 770,
        "y": 1120
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# Les jeux sklearn sont complets : aucun NaN, aucun doublon.\n# On les abîme donc volontairement, avec une graine fixe :\n# tout le monde obtient exactement les mêmes trous.\nrng = np.random.default_rng(42)\ndf = a.copy()\n\n# 1. Manquants au hasard (MCAR) : le trou ne dépend de rien\nfor col, taux in [('bmi', 0.08), ('bp', 0.05), ('s1', 0.10), ('s2', 0.06), ('s3', 0.04)]:\n    df.loc[rng.random(len(df)) < taux, col] = np.nan\n\n# 2. Manquants non aléatoires (MNAR) : s5 disparaît surtout\n#    quand il est élevé -> la moyenne des valeurs restantes est biaisée\nhaut = a['s5'] > a['s5'].quantile(0.8)\ndf.loc[haut & (rng.random(len(df)) < 0.6), 's5'] = np.nan\n\n# 3. Doublons : 12 patients saisis deux fois\ndf = pd.concat([df, df.sample(12, random_state=7)], ignore_index=True)\n\nout_data   = df\nout_scalar = int(df.isna().sum().sum())   # nombre total de NaN\n",
          "node_note": "Données abîmées (NaN + doublons)"
        }
      },
      "width": 430,
      "height": 420,
      "selected": false
    },
    {
      "id": "pyC",
      "type": "logic_python",
      "position": {
        "x": 1250,
        "y": 1120
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# TP03 — Exercice 1 : Audit qualité\n# 'a' = DataFrame à auditer\n# ─────────────────────────────────────\n\nimport pandas as pd\n\n# TODO 1 : Compter les NaN par colonne\nnan_count = a.isna().sum()\n\n# TODO 2 : Pourcentage de NaN par colonne\nnan_pct = (nan_count / len(a) * 100).round(2)\n\n# TODO 3 : Lignes dupliquées\nn_doublons = int(a.duplicated().sum())\n\n# Rapport de qualité\nrapport = pd.DataFrame({\n    'NaN_count': nan_count,\n    'NaN_%': nan_pct,\n    'dtype': a.dtypes\n})\n\n# TODO 4 : Calculer le % global de données manquantes\ntotal_vals = a.size\ntotal_nan  = int(a.isna().sum().sum())\npct_global = round(total_nan / total_vals * 100, 2)\n\nout_data   = rapport\nout_scalar = float(pct_global)\n",
          "node_note": "Python — Audit qualité"
        }
      },
      "width": 430,
      "height": 420,
      "selected": false
    },
