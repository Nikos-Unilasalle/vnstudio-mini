    {
      "id": "nC_inst",
      "type": "canvas_note",
      "position": {
        "x": -90,
        "y": 1120
      },
      "style": {
        "width": 540,
        "height": 400
      },
      "data": {
        "label": "Note",
        "id": "nC_inst",
        "params": {
          "text": "EXERCICE 1 — Audit complet\n\nComplétez le Python Node pour :\n\n1. Compter les NaN par colonne\n   INDICE : df.isna().sum()\n\n2. Calculer le pourcentage de NaN\n   INDICE : (nb_nan / len(df)) * 100\n\n3. Compter les lignes dupliquées\n   INDICE : df.duplicated().sum()\n\n4. Créer un rapport de qualité\n   sous forme de DataFrame\n\nout_data   = rapport de qualité (DataFrame)\nout_scalar = % de données manquantes (total)",
          "bg_color": "#fef9c3",
          "text_color": "#713f12"
        }
      },
      "width": 540,
      "height": 400,
      "selected": false
    },
    {
      "id": "dsC",
      "type": "ml_sklearn_dataset",
      "position": {
        "x": 490,
        "y": 1130
      },
      "data": {
        "label": "Sklearn Dataset",
        "params": {
          "dataset": 3,
