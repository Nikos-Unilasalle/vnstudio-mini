        "label": "Python Node",
        "params": {
          "code": "# F — EXERCICE : un arbre de décision sur les vins\n# Complétez les lignes marquées ←  (modèle : le cadre C)\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.metrics import accuracy_score\n\n# 1. X : toutes les colonnes sauf 'target' ; y : la colonne 'target'\nX = None   # ←\ny = None   # ←\n\n# 2. Découpage 80 / 20, random_state=42\n# X_train, X_test, y_train, y_test = train_test_split(...)   ←\n\n# 3. Un arbre de profondeur maximale 3, puis l'entraînement\n# modele = DecisionTreeClassifier(...)   ←\n# modele.fit(...)                        ←\n\n# 4. La précision sur le test\nout_score = None   # ←\n\n# Bonus : dessiner l'arbre (retirez les # des 4 lignes)\n# from sklearn.tree import plot_tree\n# import matplotlib.pyplot as plt\n# plt.figure(figsize=(14, 7))\n# plot_tree(modele, feature_names=list(X.columns), filled=True, fontsize=7)\n",
