    {
      "id": "pyD",
      "type": "logic_python",
      "position": {
        "x": 920,
        "y": 2240
      },
      "data": {
        "label": "Python Node",
        "params": {
          "code": "# D — Quel k choisir ? On essaie k = 1 à 30\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nimport matplotlib.pyplot as plt\n\nX = a.drop(columns=['target'])\ny = a['target']\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.3, random_state=42, stratify=y)\n\nvaleurs_k = list(range(1, 31))   # 1, 2, 3, … 30\nscores_train = []                # listes vides, remplies dans la boucle\nscores_test = []\nfor k in valeurs_k:\n    modele = KNeighborsClassifier(n_neighbors=k)\n    modele.fit(X_train, y_train)\n    scores_train.append(modele.score(X_train, y_train))\n    scores_test.append(modele.score(X_test, y_test))\n\n# Le tableau des résultats, et la meilleure ligne\nout_resultats = pd.DataFrame({'k': valeurs_k, 'train': scores_train, 'test': scores_test})\nmeilleur = out_resultats.loc[out_resultats['test'].idxmax()]\nprint(\"Meilleur k :\", int(meilleur['k']), \" précision test :\", round(meilleur['test'], 3))\n\n# La courbe\nplt.figure(figsize=(7, 4))\nplt.plot(valeurs_k, scores_train, 'o-', label='train')\nplt.plot(valeurs_k, scores_test, 's-', label='test')\nplt.xlabel('k (nombre de voisins)')\nplt.ylabel('précision')\nplt.legend()\nplt.grid(alpha=0.3)\n",
          "node_note": "Boucle sur k"
        },
