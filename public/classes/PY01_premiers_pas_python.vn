      "data": {
        "label": "Note",
        "id": "nG2",
        "params": {
          "text": "## Corrigé (essayez d'abord !)\n\n```python\nmoyennes = a.groupby('target')['petal length (cm)'].mean()\nout_moyennes = moyennes\nout_max = moyennes.max()\nprint(\"Plus longs pétales :\", moyennes.idxmax())\n\nimport matplotlib.pyplot as plt\nmoyennes.plot(kind='bar', color='teal')\nplt.ylabel(\"longueur moyenne (cm)\")\n```",
          "bg_color": "#ede9fe",
          "text_color": "#4c1d95"
        }
      },
      "width": 560,
      "height": 380,
      "selected": false
    },
