        "params": {
          "code": "# C — Inspecter ce qui arrive dans a et b\n# Quand on ne sait pas ce qu'on manipule, on renvoie son type\n# et sa forme, puis on les lit dans un Inspector.\n\nout_type_a = str(type(a))        # quel type d'objet ?\nout_taille = list(a.shape)       # [nombre de lignes, nombre de colonnes]\nout_colonnes = list(a.columns)   # les noms EXACTS des colonnes\n\nout_type_b = str(type(b))        # b vient de la node Number\nout_double_b = b * 2             # on calcule directement avec\n",
          "node_note": "type() et shape"
        },
